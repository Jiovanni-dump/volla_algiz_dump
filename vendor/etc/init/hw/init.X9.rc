# X9 .rc configure

on boot
    chown root system /sys/devices/platform/goodix_ts.0/gesture/single_en
    chmod 0664 /sys/devices/platform/goodix_ts.0/gesture/single_en
    chown root system /sys/devices/platform/goodix_ts.0/gesture/single_tap_pressed
    chmod 0664 /sys/devices/platform/goodix_ts.0/gesture/single_tap_pressed
    chown root system /sys/devices/platform/goodix_ts.0/gesture/fod_pressed
    chmod 0664 /sys/devices/platform/goodix_ts.0/gesture/fod_pressed
    chown root system /sys/devices/platform/goodix_ts.0/gesture/fod_en
    chmod 0664 /sys/devices/platform/goodix_ts.0/gesture/fod_en
    chown root system /sys/devices/platform/goodix_ts.0/gesture/double_tap_pressed
    chmod 0664 /sys/devices/platform/goodix_ts.0/gesture/double_tap_pressed
    chown root system /sys/devices/platform/goodix_ts.0/gesture/double_en
    chmod 0664 /sys/devices/platform/goodix_ts.0/gesture/double_en

    chown root system /proc/mtk_battery_cmd/cmd_charge_disable
    chmod 0664 /proc/mtk_battery_cmd/cmd_charge_disable

    chown root system /sys/devices/platform/charger/user_fast_charge_enabled
    chmod 0664 /sys/devices/platform/charger/user_fast_charge_enabled

    chown root system /sys/devices/platform/14013000.dsi/hbm
    chmod 0664 /sys/devices/platform/14013000.dsi/hbm
